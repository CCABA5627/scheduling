    DAYS.forEach(d=>{
      const slots=(c.schedule[d]||[]).slice().sort((a,b)=>timeToMin(a)-timeToMin(b));
      if(!slots.length)return;
      const groups=[];let cur=null;
      slots.forEach(t=>{const sid=getAsgn(c.id,d,t);if(!cur||cur.sid!==sid){cur={from:t,to:t,sid};groups.push(cur);}else cur.to=t;});
      groups.forEach(g=>{
        const staffName=g.sid?gs(g.sid)?.name:'UNASSIGNED';
        const inPod=g.sid?(S.pods[c.id]||[]).includes(g.sid)?'Yes':'No':'N/A';
        rows.push([c.name,d,g.from,g.to,staffName,inPod,'']);
      });
    });
  });
  rows.push([]);
  rows.push(['=== PODS ===']);
  rows.push(['Client','Pod Member 1','Pod Member 2','Pod Member 3','Pod Member 4','Pod Member 5','Pod Member 6','Pod Member 7']);
  S.clients.forEach(c=>{
    const pod=(S.pods[c.id]||[]).map(sid=>gs(sid)?.name||sid);
    rows.push([c.name,...pod,...Array(Math.max(0,7-pod.length)).fill('')]);
  });
  rows.push([]);
  rows.push(['=== STAFF AVAILABILITY ===']);
  rows.push(['Staff','Day','Available From','Available To','Total Slots']);
  S.staff.forEach(s=>{
    DAYS.forEach(d=>{
      const slots=(s.availability[d]||[]).slice().sort((a,b)=>timeToMin(a)-timeToMin(b));
      if(!slots.length)return;
      rows.push([s.name,d,slots[0],slots[slots.length-1],slots.length]);
    });
  });
  rows.push([]);
  rows.push(['=== CLIENT SCHEDULES ===']);
  rows.push(['Client','Day','Scheduled From','Scheduled To','Total Slots']);
  S.clients.forEach(c=>{
    DAYS.forEach(d=>{
      const slots=(c.schedule[d]||[]).slice().sort((a,b)=>timeToMin(a)-timeToMin(b));
      if(!slots.length)return;
      rows.push([c.name,d,slots[0],slots[slots.length-1],slots.length]);
    });
  });
  const csvContent=rows.map(r=>r.map(cell=>{const s=String(cell||'');return s.includes(',')||s.includes('"')||s.includes('\n')?'"'+s.replace(/"/g,'""')+'"':s;}).join(',')).join('\n');
  const bom='\uFEFF';
  const blob=new Blob([bom+csvContent],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;a.download='PodScheduler-Export.csv';a.click();URL.revokeObjectURL(url);
  showToast('Exported as CSV (open in Excel)',false);
}
function ini(n){return n.split(' ').map(w=>w[0]).join('').toUpperCase().slice(0,2);}
function gc(id){return S.clients.find(c=>c.id===id);}
function gs(id){return S.staff.find(s=>s.id===id);}
function overlap(sid,cid){const c=gc(cid),s=gs(sid);if(!c||!s)return 0;let o=0;DAYS.forEach(d=>{const cs=new Set(c.schedule[d]||[]);(s.availability[d]||[]).forEach(t=>{if(cs.has(t))o++;});});return o;}
function bestFor(cid,day,slot,excl){const pod=S.pods[cid]||[];const res=[];pod.forEach(sid=>{if(sid===excl||S.calledOut.includes(sid))return;const s=gs(sid);if(!s)return;if((s.availability[day]||[]).includes(slot))res.push({sid,score:overlap(sid,cid)});});return res.sort((a,b)=>b.score-a.score);}
function getAsgn(cid,day,slot){return S.assignments[cid]?.[day]?.[slot]||null;}
function setAsgn(cid,day,slot,sid){if(!S.assignments[cid])S.assignments[cid]={};if(!S.assignments[cid][day])S.assignments[cid][day]={};S.assignments[cid][day][slot]=sid;}
function delAsgn(cid,day,slot){if(S.assignments[cid]?.[day])delete S.assignments[cid][day][slot];}
